--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/quest/evidence/QuestEvidenceNativeMenuTest.java
@@ -0,0 +1,137 @@
+package dev.starcore.starcore.quest.evidence;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.quest.*;
+import dev.starcore.starcore.quest.gui.QuestMenu;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+import net.kyori.adventure.text.Component;
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.InventoryHolder;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.ItemMeta;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedConstruction;
+import org.mockito.MockedStatic;
+
+/**
+ * Executes the actual native detail renderer against an inventory enforcing its requested frame
+ * size.
+ */
+class QuestEvidenceNativeMenuTest {
+  private record Rendered(
+      Inventory inventory, ItemStack[] slots, QuestService quests, Player player, Quest quest) {}
+
+  private Rendered render(boolean active, boolean ready) {
+    UUID id = UUID.randomUUID();
+    Player player = mock(Player.class);
+    when(player.getUniqueId()).thenReturn(id);
+    QuestService quests = mock(QuestService.class);
+    PlayerQuest playerState = mock(PlayerQuest.class);
+    QuestObjective objective =
+        new QuestObjective("kill", QuestObjective.ObjectiveType.KILL_ENTITY, "Defeat a zombie", 1);
+    if (ready) objective.setProgress(1);
+    Quest quest =
+        new Quest.Builder(
+                "native-menu-probe",
+                "Native menu probe",
+                "Actual native objective",
+                QuestType.SIDE,
+                QuestDifficulty.NORMAL)
+            .addObjective(objective)
+            .build();
+    when(quests.getPlayerQuest(id)).thenReturn(playerState);
+    when(playerState.hasActiveQuest(quest.getId())).thenReturn(active);
+    when(playerState.getActiveQuest(quest.getId())).thenReturn(active ? quest : null);
+    AtomicReference<Inventory> created = new AtomicReference<>();
+    AtomicReference<ItemStack[]> slots = new AtomicReference<>();
+    try (MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class);
+        MockedConstruction<ItemStack> items =
+            mockConstruction(
+                ItemStack.class,
+                (item, context) -> {
+                  when(item.getItemMeta()).thenReturn(mock(ItemMeta.class));
+                  when(item.getType()).thenReturn((Material) context.arguments().getFirst());
+                })) {
+      bukkit
+          .when(
+              () ->
+                  Bukkit.createInventory(
+                      any(InventoryHolder.class), anyInt(), any(Component.class)))
+          .thenAnswer(
+              call -> {
+                int size = call.getArgument(1);
+                ItemStack[] frame = new ItemStack[size];
+                Inventory inventory = mock(Inventory.class);
+                when(inventory.getSize()).thenReturn(size);
+                when(inventory.getHolder()).thenReturn(call.getArgument(0));
+                doAnswer(
+                        write -> {
+                          int index = write.getArgument(0);
+                          if (index < 0 || index >= frame.length)
+                            throw new IndexOutOfBoundsException(
+                                "Native menu wrote slot "
+                                    + index
+                                    + " into "
+                                    + frame.length
+                                    + " slots");
+                          frame[index] = write.getArgument(1);
+                          return null;
+                        })
+                    .when(inventory)
+                    .setItem(anyInt(), any(ItemStack.class));
+                when(inventory.getItem(anyInt()))
+                    .thenAnswer(
+                        read -> {
+                          int index = read.getArgument(0);
+                          if (index < 0 || index >= frame.length)
+                            throw new IndexOutOfBoundsException(
+                                "Native menu read outside requested frame");
+                          return frame[index];
+                        });
+                created.set(inventory);
+                slots.set(frame);
+                return inventory;
+              });
+      QuestMenu menu =
+          new QuestMenu(quests, mock(DailyQuestService.class), mock(CommissionService.class));
+      assertDoesNotThrow(() -> menu.openQuestDetail(player, quest));
+      verify(player).openInventory(created.get());
+      assertSame(created.get(), created.get().getHolder().getInventory());
+      verify(quests, never()).completeQuest(any(Player.class), anyString());
+      return new Rendered(created.get(), slots.get(), quests, player, quest);
+    }
+  }
+
+  @Test
+  void availableDetailFitsRealBackButtonAndBothBorderRows() {
+    Rendered rendered = render(false, false);
+    assertEquals(54, rendered.slots().length);
+    assertNotNull(rendered.slots()[30]);
+    assertEquals(Material.ARROW, rendered.slots()[49].getType());
+    for (int i = 45; i < 54; i++) assertNotNull(rendered.slots()[i]);
+  }
+
+  @Test
+  void activeIncompleteDetailDoesNotExposeTheNativeCompleteButton() {
+    Rendered rendered = render(true, false);
+    assertEquals(54, rendered.slots().length);
+    assertEquals(Material.RED_DYE, rendered.slots()[30].getType());
+    assertNull(rendered.slots()[32]);
+    assertEquals(Material.ARROW, rendered.slots()[49].getType());
+  }
+
+  @Test
+  void actualReadyQuestKeepsCompleteAtSlot32AndBackAt49WithoutCompletingOnRender() {
+    Rendered rendered = render(true, true);
+    assertEquals(Material.NETHER_STAR, rendered.slots()[32].getType());
+    assertEquals(Material.ARROW, rendered.slots()[49].getType());
+    verify(rendered.quests(), never()).completeQuest(rendered.player(), rendered.quest().getId());
+  }
+}
