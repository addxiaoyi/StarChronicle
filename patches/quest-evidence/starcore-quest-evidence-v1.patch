diff --git a/src/main/java/dev/starcore/starcore/quest/evidence/QuestCompletionJournal.java b/src/main/java/dev/starcore/starcore/quest/evidence/QuestCompletionJournal.java
new file mode 100644
index 0000000..83845e7
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/quest/evidence/QuestCompletionJournal.java
@@ -0,0 +1,81 @@
+package dev.starcore.starcore.quest.evidence;
+
+import com.google.gson.Gson;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.List;
+
+/** One immutable, force-confirmed completion file per run. Corrupt entries fail closed. */
+public final class QuestCompletionJournal {
+  private static final Gson GSON = new Gson();
+  private final Path directory;
+
+  public QuestCompletionJournal(Path directory) {
+    this.directory = directory;
+  }
+
+  public synchronized void append(QuestEvidenceService.Snapshot snapshot) throws IOException {
+    if (!"COMPLETED".equals(snapshot.status())
+        || snapshot.completionId() == null
+        || !snapshot
+            .completionId()
+            .matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+        || snapshot.committedAt() <= 0)
+      throw new IllegalArgumentException("Not a committed completion");
+    Files.createDirectories(directory);
+    Path target = directory.resolve(snapshot.completionId() + ".json");
+    if (Files.exists(target)) {
+      if (!snapshot.equals(read(target)))
+        throw new IOException("Conflicting completion journal entry");
+      return;
+    }
+    byte[] json = GSON.toJson(snapshot).getBytes(StandardCharsets.UTF_8);
+    try (FileChannel channel =
+        FileChannel.open(target, StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE)) {
+      ByteBuffer buffer = ByteBuffer.wrap(json);
+      while (buffer.hasRemaining()) channel.write(buffer);
+      channel.force(true);
+    }
+    // Some supported platforms do not expose directory handles. File contents are always forced.
+    try (FileChannel channel = FileChannel.open(directory, StandardOpenOption.READ)) {
+      channel.force(true);
+    } catch (java.nio.file.AccessDeniedException | UnsupportedOperationException ignored) {
+      // Windows does not permit opening a directory as a FileChannel.
+    }
+  }
+
+  public synchronized List<QuestEvidenceService.Snapshot> load() throws IOException {
+    List<QuestEvidenceService.Snapshot> result = new ArrayList<>();
+    if (!Files.exists(directory)) return result;
+    try (var entries = Files.list(directory)) {
+      for (Path path : entries.filter(p -> p.getFileName().toString().endsWith(".json")).toList()) {
+        QuestEvidenceService.Snapshot value = read(path);
+        if (!"COMPLETED".equals(value.status())
+            || value.completionId() == null
+            || !path.getFileName().toString().equals(value.completionId() + ".json")
+            || value.committedAt() <= 0
+            || value.completionEvidence() == null)
+          throw new IOException("Invalid completion journal: " + path);
+        result.add(value);
+      }
+    }
+    return List.copyOf(result);
+  }
+
+  private QuestEvidenceService.Snapshot read(Path path) throws IOException {
+    try {
+      QuestEvidenceService.Snapshot result =
+          GSON.fromJson(Files.readString(path), QuestEvidenceService.Snapshot.class);
+      if (result == null) throw new IllegalArgumentException("Empty record");
+      return result;
+    } catch (RuntimeException malformed) {
+      throw new IOException("Corrupt completion journal: " + path, malformed);
+    }
+  }
+}
