index 0000000..bd7be61
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/quest/evidence/QuestEvidenceAuthority.java
@@ -0,0 +1,116 @@
+package dev.starcore.starcore.quest.evidence;
+
+import com.google.gson.JsonParser;
+import dev.starcore.starcore.core.persistence.AtomicFilePersistence;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Properties;
+import java.util.UUID;
+
+/**
+ * Immutable storage-domain identity. Missing/corrupt identity artifacts never trigger silent
+ * rotation.
+ */
+public final class QuestEvidenceAuthority {
+  public static final String FILE_NAME = "evidence-authority.properties";
+  private static final List<String> SUFFIXES = List.of("", ".tmp", ".bak", ".bak.tmp", ".delete");
+
+  private QuestEvidenceAuthority() {}
+
+  /**
+   * One server process owns a data folder. Synchronization also prevents module reload races in
+   * this JVM.
+   */
+  public static synchronized String loadOrCreate(Path questDirectory) throws IOException {
+    Path directory = questDirectory.toAbsolutePath().normalize();
+    Path primary = directory.resolve(FILE_NAME);
+    if (Files.exists(primary)) return read(primary);
+    for (String suffix : SUFFIXES) {
+      if (!suffix.isEmpty() && Files.exists(directory.resolve(FILE_NAME + suffix)))
+        throw new IOException(
+            "Quest evidence authority is missing but recovery artifacts remain; restore the"
+                + " original authority explicitly");
+    }
+    if (hasExistingDomain(directory))
+      throw new IOException(
+          "Quest evidence authority is missing from an existing tracked domain; refusing identity"
+              + " rotation");
+    String authority = UUID.randomUUID().toString();
+    Properties properties = new Properties();
+    properties.setProperty("protocol", "1");
+    properties.setProperty("authority", authority);
+    AtomicFilePersistence.replace(
+        primary,
+        temporary -> {
+          try (OutputStream output = Files.newOutputStream(temporary)) {
+            properties.store(output, "StarCore immutable quest evidence storage authority");
+          }
+        });
+    if (!authority.equals(read(primary)))
+      throw new IOException("Quest evidence authority confirmation differs from creation");
+    return authority;
+  }
+
+  private static String read(Path primary) throws IOException {
+    if (!Files.isRegularFile(primary))
+      throw new IOException("Quest evidence authority is not a regular file");
+    Properties properties = load(primary);
+    String authority = properties.getProperty("authority");
+    try {
+      if (properties.size() != 2
+          || !"1".equals(properties.getProperty("protocol"))
+          || authority == null
+          || !UUID.fromString(authority).toString().equals(authority))
+        throw new IllegalArgumentException("Invalid authority schema or UUID");
+      return authority;
+    } catch (RuntimeException malformed) {
+      throw new IOException(
+          "Quest evidence authority is corrupt; original artifacts were preserved", malformed);
+    }
+  }
+
+  private static boolean hasExistingDomain(Path directory) throws IOException {
+    for (String suffix : SUFFIXES)
+      if (Files.exists(directory.resolve("tracked-evidence.properties" + suffix))) return true;
+    if (Files.exists(directory.resolve("completion-journal"))) return true;
+    // An index/journal may have been lost while the independent native run ledger survives.
+    for (String suffix : SUFFIXES) {
+      Path nativeState = directory.resolve("quests.properties" + suffix);
+      if (!Files.exists(nativeState)) continue;
+      if (".delete".equals(suffix) || !Files.isRegularFile(nativeState)) return true;
+      Properties state = load(nativeState);
+      for (String key : state.stringPropertyNames()) {
+        if (key.endsWith(".runCompletions")) return true;
+        if (!key.endsWith(".active")) continue;
+        try {
+          var active = JsonParser.parseString(state.getProperty(key));
+          if (active.isJsonNull()) continue;
+          for (var value : active.getAsJsonArray()) {
+            var record = value.getAsJsonObject();
+            if (record.has("bindingId")
+                && !record.get("bindingId").isJsonNull()
+                && !record.get("bindingId").getAsString().isBlank()) return true;
+          }
+        } catch (RuntimeException unknownState) {
+          throw new IOException(
+              "Cannot exclude tracked native runs from existing quest state", unknownState);
+        }
+      }
+    }
+    return false;
+  }
+
+  private static Properties load(Path path) throws IOException {
+    Properties properties = new Properties();
+    try (InputStream input = Files.newInputStream(path)) {
+      properties.load(input);
+    } catch (IllegalArgumentException malformed) {
+      throw new IOException("Invalid quest-domain properties: " + path, malformed);
+    }
+    return properties;
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/quest/evidence/QuestEvidenceService.java b/src/main/java/dev/starcore/starcore/quest/evidence/QuestEvidenceService.java
new file mode 100644
index 0000000..3745182
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/quest/evidence/QuestEvidenceService.java
@@ -0,0 +1,973 @@
+package dev.starcore.starcore.quest.evidence;
+
+import com.google.gson.Gson;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.quest.PlayerQuest;
+import dev.starcore.starcore.quest.Quest;
+import dev.starcore.starcore.quest.QuestService;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Properties;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.function.Supplier;
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.java.JavaPlugin;
+
+/**
+ * Durable native quest receipts. Only the native completeQuest path may produce completion proof.
+ * This provider supports Paper's primary owner thread. It explicitly declines Folia.
+ */
+public final class QuestEvidenceService implements AutoCloseable {
+  public static final String ISSUER = "starcore.quest.evidence.v1";
+  private static final Gson GSON = new Gson();
+  private static final String STATE_FILE = "tracked-evidence.properties";
+  private final JavaPlugin plugin;
+  private final QuestService quests;
+  private final PersistenceService persistence;
+  private final Supplier<NationService> nations;
+  private final QuestCompletionJournal journal;
+  private final Map<String, Entry> entries = new ConcurrentHashMap<>();
+  private final Map<String, Snapshot> observations = new ConcurrentHashMap<>();
+  private final Map<String, CompletableFuture<Admission>> admissions = new ConcurrentHashMap<>();
+  private final ExecutorService journalIo =
+      Executors.newSingleThreadExecutor(
+          task -> {
+            Thread thread = new Thread(task, "StarCore-quest-evidence-journal");
+            thread.setDaemon(true);
+            return thread;
+          });
+  private volatile boolean active;
+  private volatile boolean healthy = true;
+  private volatile String storageAuthorityId;
+  private final boolean paperOwnerSupported;
+
+  public QuestEvidenceService(
+      JavaPlugin plugin,
+      QuestService quests,
+      PersistenceService persistence,
+      Supplier<NationService> nations) {
+    this.plugin = Objects.requireNonNull(plugin);
+    this.quests = Objects.requireNonNull(quests);
+    this.persistence = Objects.requireNonNull(persistence);
+    this.nations = Objects.requireNonNull(nations);
+    this.journal =
+        new QuestCompletionJournal(persistence.dataDirectory().resolve("quest/completion-journal"));
+    boolean folia;
+    try {
+      Class.forName("io.papermc.paper.threadedregions.RegionizedServer");
+      folia = true;
+    } catch (ClassNotFoundException absent) {
+      folia = false;
+    }
+    paperOwnerSupported = !folia;
+  }
+
+  public int protocolVersion() {
+    return 1;
+  }
+
+  /**
+   * Stable storage-domain identity; consumers must also check available() before performing work.
+   */
+  public String storageAuthorityId() {
+    return storageAuthorityId;
+  }
+
+  public boolean available() {
+    return active
+        && healthy
+        && storageAuthorityId != null
+        && paperOwnerSupported
+        && plugin.isEnabled();
+  }
+
+  /** Called once from QuestModule on the Paper owner before publication. */
+  public void initialize() {
+    requireOwner();
+    try {
+      storageAuthorityId =
+          QuestEvidenceAuthority.loadOrCreate(persistence.dataDirectory().resolve("quest"));
+      Properties state = persistence.loadProperties("quest", STATE_FILE);
+      for (String key : state.stringPropertyNames()) {
+        Entry entry = GSON.fromJson(state.getProperty(key), Entry.class);
+        validateEntry(key, entry);
+        Snapshot snapshot = entry.snapshot();
+        if ("ADMITTING".equals(snapshot.status()) || "COMPLETING".equals(snapshot.status()))
+          snapshot =
+              unknown(
+                  snapshot, "Interrupted native state/evidence commit; reconciliation required");
+        else if ("COMPLETED".equals(snapshot.status()))
+          snapshot = unknown(snapshot, "Completion requires immutable journal confirmation");
+        entries.put(key, new Entry(snapshot, entry.expectedNation(), entry.requireSameNation()));
+      }
+      // The append-only completion record is authoritative, not a mutable index status.
+      for (Snapshot completion : journal.load()) {
+        Entry entry = entries.get(completion.bindingId());
+        if (entry == null
+            || !sameRun(entry.snapshot(), completion)
+            || !quests.hasCommittedRun(completion))
+          throw new IllegalStateException(
+              "Completion has no matching admission: " + completion.bindingId());
+        Snapshot restored =
+            "PREPARED".equals(completion.rewardStatus())
+                ? reward(
+                    completion, "UNKNOWN", "Reward execution guard survived restart; do not replay")
+                : completion;
+        // A separately persisted INVOKED status means invocation returned, never guaranteed
+        // delivery.
+        Snapshot indexed =
+            GSON.fromJson(state.getProperty(completion.bindingId()), Entry.class).snapshot();
+        if ("INVOKED".equals(indexed.rewardStatus()) && sameRun(indexed, completion))
+          restored =
+              reward(
+                  completion,
+                  "INVOKED",
+                  "Native reward invocation returned before saved checkpoint");
+        entries.put(
+            completion.bindingId(),
+            new Entry(restored, entry.expectedNation(), entry.requireSameNation()));
+      }
+      entries.forEach((binding, entry) -> observations.put(binding, entry.snapshot()));
+      active = true;
+      for (Quest quest : quests.getQuestRegistry().values()) onDefinitionRegistered(quest);
+    } catch (Exception failure) {
+      healthy = false;
+      active = false;
+      plugin.getLogger().severe("Quest evidence unavailable: " + failure.getMessage());
+    }
+  }
+
+  /** Missing binding is null, not UNKNOWN. This is a pure immutable thread-safe canonical query. */
+  public Snapshot lookup(String bindingId) {
+    return observations.get(bindingId);
+  }
+
+  /** Replayable hints only. Consumers must still validate the immutable canonical receipt. */
+  public List<Snapshot> completionHints() {
+    return observations.values().stream()
+        .filter(s -> "COMPLETED".equals(s.status()))
+        .sorted(
+            java.util.Comparator.comparingLong(Snapshot::committedAt)
+                .thenComparing(Snapshot::completionId))
+        .toList();
+  }
+
+  public CompletionStage<Admission> beginTracked(
+      UUID playerId,
+      String questId,
+      String bindingId,
+      String expectedNation,
+      boolean requireSameNation) {
+    CompletableFuture<Admission> answer = new CompletableFuture<>();
+    if (playerId == null
+        || questId == null
+        || questId.isBlank()
+        || bindingId == null
+        || !bindingId.matches("[A-Za-z0-9_.:-]{1,160}")
+        || (requireSameNation && (expectedNation == null || expectedNation.isBlank()))) {
+      answer.complete(new Admission("REJECTED", null, "Invalid tracked quest request"));
+      return answer;
+    }
+    owner(
+        () -> admit(playerId, questId, bindingId, expectedNation, requireSameNation, answer),
+        () ->
+            answer.complete(new Admission("UNAVAILABLE", null, "Native Paper owner unavailable")));
+    return answer;
+  }
+
+  private void admit(
+      UUID playerId,
+      String questId,
+      String bindingId,
+      String expectedNation,
+      boolean requireSameNation,
+      CompletableFuture<Admission> answer) {
+    Entry previous = entries.get(bindingId);
+    if (previous != null) {
+      Snapshot snapshot = previous.snapshot();
+      if (!snapshot.playerId().equals(playerId)
+          || !snapshot.questId().equals(questId)
+          || !Objects.equals(previous.expectedNation(), expectedNation)
+          || previous.requireSameNation() != requireSameNation) {
+        answer.complete(
+            new Admission("CONFLICT", null, "Binding payload differs; admission refused"));
+        return;
+      } else {
+        CompletableFuture<Admission> pending = admissions.get(bindingId);
+        if (pending != null) {
+          pending.whenComplete(
+              (value, failure) -> {
+                if (failure == null) answer.complete(value);
+                else answer.completeExceptionally(failure);
+              });
+          return;
+        }
+        // REJECTED is only a known no-mutation native early return. Keep its reserved run ID and
+        // retry.
+        if (!"REJECTED".equals(snapshot.status())) {
+          answer.complete(
+              new Admission(
+                  "IDEMPOTENT", observations.get(bindingId), "Existing immutable binding"));
+          return;
+        }
+      }
+    }
+    Player player = Bukkit.getPlayer(playerId);
+    Quest definition = quests.getQuest(questId);
+    if (player == null || !player.isOnline() || definition == null) {
+      answer.complete(new Admission("REJECTED", null, "Player offline or quest definition absent"));
+      return;
+    }
+    Nation nation = nation(playerId);
+    if (requireSameNation && "UNAVAILABLE".equals(nation.state())) {
+      answer.complete(
+          new Admission(
+              "UNAVAILABLE",
+              null,
+              "Native nation lookup unavailable; retry without assuming no nation"));
+      return;
+    }
+    if (requireSameNation
+        && (!"KNOWN_NATION".equals(nation.state()) || !expectedNation.equals(nation.id()))) {
+      answer.complete(
+          new Admission("REJECTED", null, "Current native nation is unavailable or different"));
+      return;
+    }
+    if (quests.getPlayerQuest(playerId).hasActiveQuest(questId)) {
+      answer.complete(
+          new Admission("REJECTED", null, "Unbound native run already active; never adopt it"));
+      return;
+    }
+    String fingerprint;
+    try {
+      fingerprint = QuestDefinitionFingerprint.of(definition);
+    } catch (RuntimeException invalid) {
+      answer.complete(
+          new Admission("REJECTED", null, "Unsupported definition: " + invalid.getMessage()));
+      return;
+    }
+    String run = previous == null ? UUID.randomUUID().toString() : previous.snapshot().runId();
+    Snapshot reserved =
+        new Snapshot(
+            bindingId,
+            run,
+            playerId,
+            questId,
+            fingerprint,
+            0,
+            nation.state(),
+            nation.id(),
+            nation.checkedAt(),
+            null,
+            0,
+            "UNAVAILABLE",
+            null,
+            0,
+            "ADMITTING",
+            "NOT_STARTED",
+            ISSUER,
+            null,
+            null,
+            0,
+            "binding:" + bindingId + ";run:" + run,
+            "Admission reserved; not accepted or completed");
+    admissions.put(bindingId, answer);
+    Entry entry = new Entry(reserved, expectedNation, requireSameNation);
+    persist(entry)
+        .whenComplete(
+            (ignored, failure) ->
+                owner(
+                    () -> {
+                      if (failure != null) {
+                        admissionUnknown(entry, answer, failure);
+                        return;
+                      }
+                      Player online = Bukkit.getPlayer(playerId);
+                      Nation acceptedNation = nation(playerId);
+                      if (online == null
+                          || !online.isOnline()
+                          || (requireSameNation
+                              && (!"KNOWN_NATION".equals(acceptedNation.state())
+                                  || !expectedNation.equals(acceptedNation.id())))) {
+                        rejectUnapplied(
+                            entry,
+                            answer,
+                            "Owner or required nation changed before native acceptance; no"
+                                + " mutation");
+                        return;
+                      }
+                      Quest current = quests.getQuest(questId);
+                      String currentFingerprint;
+                      try {
+                        currentFingerprint =
+                            current == null ? null : QuestDefinitionFingerprint.of(current);
+                      } catch (RuntimeException invalidDefinition) {
+                        rejectUnapplied(
+                            entry,
+                            answer,
+                            "Definition became invalid before native acceptance; no mutation");
+                        return;
+                      }
+                      if (!fingerprint.equals(currentFingerprint)) {
+                        rejectUnapplied(
+                            entry,
+                            answer,
+                            "Definition changed before native acceptance; no mutation");
+                        return;
+                      }
+                      QuestService.QuestAcceptResult accepted =
+                          quests.acceptTrackedQuest(online, questId, run, bindingId, fingerprint);
+                      if (accepted != QuestService.QuestAcceptResult.SUCCESS) {
+                        rejectUnapplied(
+                            entry,
+                            answer,
+                            "Native acceptance refused without mutation: " + accepted.name());
+                        return;
+                      }
+                      long started =
+                          quests.getPlayerQuest(playerId).getQuestStartTimes().get(questId);
+                      String acceptedEvidence =
+                          "binding:"
+                              + bindingId
+                              + ";run:"
+                              + run
+                              + ";definition:"
+                              + fingerprint
+                              + ";nativeNation:"
+                              + acceptedNation.state()
+                              + ":"
+                              + acceptedNation.id()
+                              + ":"
+                              + acceptedNation.checkedAt();
+                      Snapshot acceptedSnapshot =
+                          new Snapshot(
+                              bindingId,
+                              run,
+                              playerId,
+                              questId,
+                              fingerprint,
+                              started,
+                              acceptedNation.state(),
+                              acceptedNation.id(),
+                              acceptedNation.checkedAt(),
+                              null,
+                              0,
+                              "UNAVAILABLE",
+                              null,
+                              0,
+                              "ACTIVE",
+                              "NOT_STARTED",
+                              ISSUER,
+                              acceptedEvidence,
+                              null,
+                              0,
+                              acceptedEvidence,
+                              "Native acceptance and quest-state persistence awaiting"
+                                  + " confirmation");
+                      quests
+                          .saveConfirmed()
+                          .thenCompose(
+                              v ->
+                                  persist(
+                                      new Entry(
+                                          acceptedSnapshot, expectedNation, requireSameNation)))
+                          .whenComplete(
+                              (v, error) ->
+                                  owner(
+                                      () -> {
+                                        if (error != null) {
+                                          admissionUnknown(
+                                              new Entry(
+                                                  acceptedSnapshot,
+                                                  expectedNation,
+                                                  requireSameNation),
+                                              answer,
+                                              error);
+                                          return;
+                                        }
+                                        observations.put(bindingId, acceptedSnapshot);
+                                        finishAdmission(
+                                            bindingId,
+                                            answer,
+                                            new Admission(
+                                                "ADMITTED",
+                                                acceptedSnapshot,
+                                                "Durable native run accepted"));
+                                        // Start commands run only after acceptance ack and are
+                                        // never replayed after restart.
+                                        try {
+                                          quests.executeTrackedStart(online, current);
+                                        } catch (RuntimeException commandFailure) {
+                                          plugin
+                                              .getLogger()
+                                              .warning(
+                                                  "Tracked quest start command failed: "
+                                                      + bindingId);
+                                        }
+                                      },
+                                      () ->
+                                          admissionUnknown(
+                                              new Entry(
+                                                  acceptedSnapshot,
+                                                  expectedNation,
+                                                  requireSameNation),
+                                              answer,
+                                              new IllegalStateException(
+                                                  "Provider disabled during acceptance commit"))));
+                    },
+                    () ->
+                        admissionUnknown(
+                            entry,
+                            answer,
+                            new IllegalStateException("Provider disabled before acceptance"))));
+  }
+
+  /**
+   * Called only by QuestService.completeQuest after its real objective checks, on the native owner.
+   */
+  public QuestService.QuestCompleteResult completeNative(Player player, String questId) {
+    requireOwner();
+    PlayerQuest playerQuest = quests.getPlayerQuest(player.getUniqueId());
+    String binding = playerQuest.getQuestBindingId(questId);
+    Entry entry = binding == null ? null : entries.get(binding);
+    if (!available() || entry == null || !"ACTIVE".equals(entry.snapshot().status()))
+      return new QuestService.QuestCompleteResult(false, "原生完成证据暂不可用或正在提交");
+    Snapshot before = entry.snapshot();
+    Quest quest = playerQuest.getActiveQuest(questId);
+    if (!matchesActive(before, quest, playerQuest)
+        || !quest.isAllObjectivesCompleted()
+        || playerQuest.isQuestExpired(questId)) {
+      markUnknown(entry, "Native run or definition differs; reconciliation required");
+      return new QuestService.QuestCompleteResult(false, "任务运行标识或定义不一致");
+    }
+    Nation completedNation = nation(player.getUniqueId());
+    if (entry.requireSameNation()
+        && (!"KNOWN_NATION".equals(completedNation.state())
+            || !Objects.equals(entry.expectedNation(), completedNation.id())
+            || !Objects.equals(before.acceptedNation(), completedNation.id())))
+      return new QuestService.QuestCompleteResult(false, "需要接取时相同的有效原生国家");
+    String completionId = UUID.randomUUID().toString();
+    // PREPARED is a durable execution guard, explicitly not completion proof.
+    Snapshot prepared =
+        new Snapshot(
+            before.bindingId(),
+            before.runId(),
+            before.playerId(),
+            before.questId(),
+            before.definitionFingerprint(),
+            before.startedAt(),
+            before.acceptedNationState(),
+            before.acceptedNation(),
+            before.acceptedNationCheckedAt(),
+            null,
+            0,
+            completedNation.state(),
+            completedNation.id(),
+            completedNation.checkedAt(),
+            "COMPLETING",
+            "PREPARED",
+            ISSUER,
+            before.acceptedEvidence(),
+            null,
+            0,
+            before.evidence(),
+            "Reward guard prepared; native completion is not yet committed");
+    persist(new Entry(prepared, entry.expectedNation(), entry.requireSameNation()))
+        .whenComplete(
+            (v, error) ->
+                owner(
+                    () -> {
+                      if (error != null) {
+                        markUnknown(entry, "Guard persistence failed; no rewards invoked");
+                        return;
+                      }
+                      Nation finalNation = nation(player.getUniqueId());
+                      if (!player.isOnline()
+                          || !matchesActive(
+                              before, playerQuest.getActiveQuest(questId), playerQuest)
+                          || (entry.requireSameNation()
+                              && (!"KNOWN_NATION".equals(finalNation.state())
+                                  || !Objects.equals(entry.expectedNation(), finalNation.id())))) {
+                        markUnknown(
+                            entry,
+                            "Owner/run/nation changed before native commit; no rewards invoked");
+                        return;
+                      }
+                      long completedAt = System.currentTimeMillis();
+                      if (!quests.commitTrackedCompletion(
+                          player.getUniqueId(),
+                          questId,
+                          before.runId(),
+                          completedAt,
+                          completionId)) {
+                        markUnknown(
+                            entry, "Native objective completion refused; no rewards invoked");
+                        return;
+                      }
+                      quests
+                          .saveConfirmed()
+                          .whenComplete(
+                              (saved, saveFailure) -> {
+                                if (saveFailure != null) {
+                                  markUnknown(
+                                      new Entry(
+                                          prepared,
+                                          entry.expectedNation(),
+                                          entry.requireSameNation()),
+                                      "Native quest-state save failed; no completion proof or"
+                                          + " reward replay");
+                                  return;
+                                }
+                                long committedAt = System.currentTimeMillis();
+                                String completionEvidence =
+                                    before.acceptedEvidence()
+                                        + ";completion:"
+                                        + completionId
+                                        + ";nativeQuestStateAck:"
+                                        + committedAt
+                                        + ";nativeNation:"
+                                        + finalNation.state()
+                                        + ":"
+                                        + finalNation.id()
+                                        + ":"
+                                        + finalNation.checkedAt();
+                                Snapshot committed =
+                                    new Snapshot(
+                                        before.bindingId(),
+                                        before.runId(),
+                                        before.playerId(),
+                                        before.questId(),
+                                        before.definitionFingerprint(),
+                                        before.startedAt(),
+                                        before.acceptedNationState(),
+                                        before.acceptedNation(),
+                                        before.acceptedNationCheckedAt(),
+                                        completionId,
+                                        completedAt,
+                                        finalNation.state(),
+                                        finalNation.id(),
+                                        finalNation.checkedAt(),
+                                        "COMPLETED",
+                                        "PREPARED",
+                                        ISSUER,
+                                        before.acceptedEvidence(),
+                                        completionEvidence,
+                                        committedAt,
+                                        completionEvidence,
+                                        "Native quest state acknowledged; immutable completion"
+                                            + " append pending");
+                                appendCompletion(committed)
+                                    .whenComplete(
+                                        (written, journalFailure) -> {
+                                          if (journalFailure != null) {
+                                            markUnknown(
+                                                new Entry(
+                                                    prepared,
+                                                    entry.expectedNation(),
+                                                    entry.requireSameNation()),
+                                                "Completion append uncertain; no completion proof"
+                                                    + " or reward replay");
+                                            return;
+                                          }
+                                          observations.put(
+                                              binding,
+                                              committed); // proof becomes visible only after both
+                                          // durable acknowledgements
+                                          owner(
+                                              () -> {
+                                                Entry committedEntry =
+                                                    new Entry(
+                                                        committed,
+                                                        entry.expectedNation(),
+                                                        entry.requireSameNation());
+                                                persist(committedEntry)
+                                                    .whenComplete(
+                                                        (indexed, indexFailure) ->
+                                                            owner(
+                                                                () -> {
+                                                                  if (indexFailure != null) {
+                                                                    observations.put(
+                                                                        binding,
+                                                                        reward(
+                                                                            committed,
+                                                                            "UNKNOWN",
+                                                                            "Reward index failed;"
+                                                                                + " no replay"));
+                                                                    return;
+                                                                  }
+                                                                  if (!player.isOnline()) {
+                                                                    recordReward(
+                                                                        committedEntry,
+                                                                        "UNKNOWN",
+                                                                        "Player left after commit;"
+                                                                            + " no automatic reward"
+                                                                            + " replay");
+                                                                    return;
+                                                                  }
+                                                                  try {
+                                                                    quests.executeTrackedReward(
+                                                                        player, quest);
+                                                                    recordReward(
+                                                                        committedEntry,
+                                                                        "INVOKED",
+                                                                        "Native reward methods"
+                                                                            + " returned; delivery"
+                                                                            + " is not asserted");
+                                                                    player.sendMessage(
+                                                                        "§6[任务] §a完成记录已持久确认："
+                                                                            + quest.getName());
+                                                                  } catch (
+                                                                      RuntimeException
+                                                                          rewardFailure) {
+                                                                    recordReward(
+                                                                        committedEntry,
+                                                                        "UNKNOWN",
+                                                                        "Native rewards may be"
+                                                                            + " partial; manual"
+                                                                            + " reconciliation"
+                                                                            + " required");
+                                                                  }
+                                                                },
+                                                                () ->
+                                                                    observations.put(
+                                                                        binding,
+                                                                        reward(
+                                                                            committed,
+                                                                            "UNKNOWN",
+                                                                            "Provider disabled"
+                                                                                + " before reward"
+                                                                                + " invocation; no"
+                                                                                + " replay"))));
+                                              },
+                                              () ->
+                                                  observations.put(
+                                                      binding,
+                                                      reward(
+                                                          committed,
+                                                          "UNKNOWN",
+                                                          "Provider disabled after canonical"
+                                                              + " commit; no replay")));
+                                        });
+                              });
+                    },
+                    () ->
+                        markUnknown(
+                            entry,
+                            "Provider disabled before completion commit; no reward replay")));
+    return new QuestService.QuestCompleteResult(false, "任务目标已验证，正在持久确认完成记录");
+  }
+
+  /**
+   * Called after template registration/restoration, never silently replaces a historic definition.
+   */
+  public void onDefinitionRegistered(Quest definition) {
+    requireOwner();
+    for (Entry entry : new ArrayList<>(entries.values())) {
+      Snapshot value = entry.snapshot();
+      if (!value.questId().equals(definition.getId()) || !"ACTIVE".equals(value.status())) continue;
+      PlayerQuest player = quests.getPlayerQuest(value.playerId());
+      if (!matchesActive(value, player.getActiveQuest(value.questId()), player)) {
+        if (!player.hasActiveQuest(value.questId())
+            && player.getFailedQuests().containsKey(value.questId()))
+          failNative(value.playerId(), value.questId());
+        else
+          markUnknown(entry, "Restored run/start/definition does not match immutable acceptance");
+      }
+    }
+  }
+
+  public void abandonNative(UUID playerId, String questId) {
+    terminateNative(playerId, questId, "ABANDONED", "Native run was abandoned");
+  }
+
+  /** Notify canonical readers when the native owner expires an accepted run. */
+  public void failNative(UUID playerId, String questId) {
+    terminateNative(playerId, questId, "FAILED", "Native run expired or failed");
+  }
+
+  private void terminateNative(UUID playerId, String questId, String status, String reason) {
+    requireOwner();
+    for (Entry entry : new ArrayList<>(entries.values())) {
+      Snapshot current = entry.snapshot();
+      if (!current.playerId().equals(playerId)
+          || !current.questId().equals(questId)
+          || !"ACTIVE".equals(current.status())) continue;
+      Snapshot terminal = state(current, status, current.rewardStatus(), reason);
+      Entry updated = new Entry(terminal, entry.expectedNation(), entry.requireSameNation());
+      // Publish only a negative terminal state before the file write; it can never satisfy
+      // a completion gate, and the durable callback downgrades it to UNKNOWN on failure.
+      observations.put(current.bindingId(), terminal);
+      persist(updated)
+          .whenComplete(
+              (ignored, failure) ->
+                  observations.put(
+                      current.bindingId(),
+                      failure == null
+                          ? terminal
+                          : unknown(
+                              terminal,
+                              "Native terminal-state persistence failed; reconciliation"
+                                  + " required")));
+    }
+  }
+
+  private boolean matchesActive(Snapshot snapshot, Quest quest, PlayerQuest player) {
+    return quest != null
+        && snapshot.playerId().equals(player.getPlayerId())
+        && snapshot.questId().equals(quest.getId())
+        && snapshot.runId().equals(player.getQuestRunId(snapshot.questId()))
+        && snapshot.bindingId().equals(player.getQuestBindingId(snapshot.questId()))
+        && Objects.equals(snapshot.startedAt(), player.getQuestStartTimes().get(snapshot.questId()))
+        && snapshot
+            .definitionFingerprint()
+            .equals(player.getQuestDefinitionFingerprint(snapshot.questId()))
+        && snapshot.definitionFingerprint().equals(QuestDefinitionFingerprint.of(quest))
+        && quests.getQuest(snapshot.questId()) != null
+        && snapshot
+            .definitionFingerprint()
+            .equals(QuestDefinitionFingerprint.of(quests.getQuest(snapshot.questId())));
+  }
+
+  private synchronized CompletionStage<Void> persist(Entry entry) {
+    entries.put(entry.snapshot().bindingId(), entry);
+    Properties properties = new Properties();
+    entries.forEach((key, value) -> properties.setProperty(key, GSON.toJson(value)));
+    try {
+      return persistence.savePropertiesAsync("quest", STATE_FILE, properties);
+    } catch (RuntimeException failure) {
+      return CompletableFuture.failedFuture(failure);
+    }
+  }
+
+  private CompletionStage<Void> appendCompletion(Snapshot snapshot) {
+    try {
+      return CompletableFuture.runAsync(
+          () -> {
+            try {
+              journal.append(snapshot);
+            } catch (Exception failure) {
+              throw new java.util.concurrent.CompletionException(failure);
+            }
+          },
+          journalIo);
+    } catch (RuntimeException disabled) {
+      return CompletableFuture.failedFuture(disabled);
+    }
+  }
+
+  private void recordReward(Entry entry, String status, String message) {
+    Snapshot changed = reward(entry.snapshot(), status, message);
+    persist(new Entry(changed, entry.expectedNation(), entry.requireSameNation()))
+        .whenComplete(
+            (v, failure) ->
+                observations.put(
+                    changed.bindingId(),
+                    failure == null
+                        ? changed
+                        : reward(changed, "UNKNOWN", "Reward checkpoint failed; no replay")));
+  }
+
+  private void markUnknown(Entry entry, String reason) {
+    Snapshot changed = unknown(entry.snapshot(), reason);
+    observations.put(changed.bindingId(), changed);
+    persist(new Entry(changed, entry.expectedNation(), entry.requireSameNation()))
+        .exceptionally(failure -> null);
+  }
+
+  private void admissionUnknown(
+      Entry entry, CompletableFuture<Admission> answer, Throwable failure) {
+    markUnknown(entry, "Admission uncertain: " + failure.getMessage());
+    finishAdmission(
+        entry.snapshot().bindingId(),
+        answer,
+        new Admission(
+            "UNKNOWN",
+            lookup(entry.snapshot().bindingId()),
+            "Native admission requires reconciliation"));
+  }
+
+  /** Safe retry is allowed only while native accept has definitely not changed player state. */
+  private void rejectUnapplied(Entry entry, CompletableFuture<Admission> answer, String reason) {
+    Snapshot refused = state(entry.snapshot(), "REJECTED", "NOT_STARTED", reason);
+    persist(new Entry(refused, entry.expectedNation(), entry.requireSameNation()))
+        .whenComplete(
+            (v, failure) -> {
+              if (failure != null) {
+                admissionUnknown(
+                    entry,
+                    answer,
+                    new IllegalStateException("Known rejection checkpoint failed", failure));
+                return;
+              }
+              observations.put(refused.bindingId(), refused);
+              finishAdmission(
+                  refused.bindingId(), answer, new Admission("REJECTED", refused, reason));
+            });
+  }
+
+  private void finishAdmission(
+      String binding, CompletableFuture<Admission> answer, Admission value) {
+    admissions.remove(binding, answer);
+    answer.complete(value);
+  }
+
+  private Nation nation(UUID playerId) {
+    long checked = System.currentTimeMillis();
+    try {
+      NationService service = nations.get();
+      if (service == null) return new Nation("UNAVAILABLE", null, checked);
+      var nativeNation = service.nationOf(playerId);
+      if (nativeNation == null) return new Nation("UNAVAILABLE", null, checked);
+      return nativeNation
+          .map(n -> new Nation("KNOWN_NATION", n.id().value().toString(), checked))
+          .orElseGet(() -> new Nation("KNOWN_NONE", null, checked));
+    } catch (RuntimeException failure) {
+      return new Nation("UNAVAILABLE", null, checked);
+    }
+  }
+
+  private void owner(Runnable action, Runnable unavailable) {
+    if (!available()) {
+      unavailable.run();
+      return;
+    }
+    Runnable checked =
+        () -> {
+          if (!available()) {
+            unavailable.run();
+            return;
+          }
+          try {
+            action.run();
+          } catch (RuntimeException failure) {
+            plugin
+                .getLogger()
+                .warning("Quest evidence owner action failed: " + failure.getMessage());
+            unavailable.run();
+          }
+        };
+    if (Bukkit.isPrimaryThread()) checked.run();
+    else
+      try {
+        Bukkit.getScheduler().runTask(plugin, checked);
+      } catch (RuntimeException disabled) {
+        unavailable.run();
+      }
+  }
+
+  private void requireOwner() {
+    if (!Bukkit.isPrimaryThread())
+      throw new IllegalStateException("Native quest evidence requires Paper primary owner");
+  }
+
+  private static void validateEntry(String key, Entry entry) {
+    if (entry == null
+        || entry.snapshot() == null
+        || !key.equals(entry.snapshot().bindingId())
+        || entry.snapshot().runId() == null
+        || entry.snapshot().playerId() == null
+        || entry.snapshot().questId() == null
+        || entry.snapshot().definitionFingerprint() == null
+        || !entry.snapshot().definitionFingerprint().matches("[0-9a-f]{64}")
+        || !ISSUER.equals(entry.snapshot().issuer()))
+      throw new IllegalStateException("Corrupt tracked evidence entry");
+  }
+
+  private static boolean sameRun(Snapshot a, Snapshot b) {
+    return Objects.equals(a.bindingId(), b.bindingId())
+        && Objects.equals(a.runId(), b.runId())
+        && Objects.equals(a.playerId(), b.playerId())
+        && Objects.equals(a.questId(), b.questId())
+        && Objects.equals(a.definitionFingerprint(), b.definitionFingerprint())
+        && a.startedAt() == b.startedAt()
+        && Objects.equals(a.acceptedEvidence(), b.acceptedEvidence())
+        && Objects.equals(a.acceptedNationState(), b.acceptedNationState())
+        && Objects.equals(a.acceptedNation(), b.acceptedNation())
+        && a.acceptedNationCheckedAt() == b.acceptedNationCheckedAt();
+  }
+
+  private static Snapshot unknown(Snapshot s, String message) {
+    return state(
+        s, "UNKNOWN", "PREPARED".equals(s.rewardStatus()) ? "UNKNOWN" : s.rewardStatus(), message);
+  }
+
+  private static Snapshot state(Snapshot s, String status, String reward, String message) {
+    boolean completed = "COMPLETED".equals(status);
+    return new Snapshot(
+        s.bindingId(),
+        s.runId(),
+        s.playerId(),
+        s.questId(),
+        s.definitionFingerprint(),
+        s.startedAt(),
+        s.acceptedNationState(),
+        s.acceptedNation(),
+        s.acceptedNationCheckedAt(),
+        completed ? s.completionId() : null,
+        s.completedAt(),
+        s.completedNationState(),
+        s.completedNation(),
+        s.completedNationCheckedAt(),
+        status,
+        reward,
+        s.issuer(),
+        s.acceptedEvidence(),
+        completed ? s.completionEvidence() : null,
+        completed ? s.committedAt() : 0,
+        s.evidence(),
+        message);
+  }
+
+  private static Snapshot reward(Snapshot s, String reward, String message) {
+    return state(s, s.status(), reward, message);
+  }
+
+  @Override
+  public void close() {
+    active = false; // invalidate the provider before module listeners or services can be reused
+    admissions.forEach(
+        (binding, future) ->
+            future.complete(new Admission("UNKNOWN", lookup(binding), "Quest module disabled")));
+    admissions.clear();
+    journalIo.shutdown();
+  }
+
+  private record Nation(String state, String id, long checkedAt) {}
+
+  private record Entry(Snapshot snapshot, String expectedNation, boolean requireSameNation) {}
+
+  public record Admission(String status, Snapshot snapshot, String message) {}
+
+  public record Snapshot(
+      String bindingId,
+      String runId,
+      UUID playerId,
+      String questId,
+      String definitionFingerprint,
+      long startedAt,
+      String acceptedNationState,
+      String acceptedNation,
+      long acceptedNationCheckedAt,
+      String completionId,
+      long completedAt,
+      String completedNationState,
+      String completedNation,
+      long completedNationCheckedAt,
+      String status,
+      String rewardStatus,
+      String issuer,
+      String acceptedEvidence,
+      String completionEvidence,
+      long committedAt,
+      String evidence,
+      String message) {}
+}
