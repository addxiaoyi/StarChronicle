+    definition.put("name", quest.getName());
+    definition.put("description", quest.getDescription());
+    definition.put("type", quest.getType().name());
+    definition.put("difficulty", quest.getDifficulty().name());
+    definition.put("prerequisites", quest.getPrerequisiteQuests());
+    definition.put("minLevel", quest.getMinLevel());
+    definition.put("maxLevel", quest.getMaxLevel());
+    definition.put("timeLimit", quest.getTimeLimit());
+    definition.put("autoAccept", quest.isAutoAccept());
+    definition.put("autoComplete", quest.isAutoComplete());
+    definition.put("repeatable", quest.isRepeatable());
+    definition.put("cooldown", quest.getCooldown());
+    definition.put("giver", quest.getNpcGiverId());
+    definition.put("completer", quest.getNpcCompleterId());
+    definition.put("startCommands", quest.getStartCommands());
+    definition.put("completeCommands", quest.getCompleteCommands());
+    definition.put("category", quest.getCategory());
+    definition.put("tags", quest.getTags());
+    List<Object> objectives = new ArrayList<>();
+    for (QuestObjective objective : quest.getObjectives()) {
+      Map<String, Object> value = new TreeMap<>();
+      value.put("id", objective.getId());
+      value.put("type", objective.getType().name());
+      value.put("description", objective.getDescription());
+      value.put("required", objective.getRequiredAmount());
+      value.put("entity", objective.getTargetEntity());
+      value.put("material", objective.getTargetMaterial());
+      value.put("item", objective.getTargetItemId());
+      value.put("npc", objective.getTargetNpcId());
+      value.put("location", objective.getTargetLocationId());
+      value.put("metadata", canonical(objective.getMetadata()));
+      objectives.add(value);
+    }
+    definition.put("objectives", objectives);
+    if (quest.getReward() != null) {
+      Map<String, Object> reward = new TreeMap<>();
+      reward.put("money", quest.getReward().getMoney());
+      reward.put("experience", quest.getReward().getExperience());
+      reward.put("skillPoints", quest.getReward().getSkillPoints());
+      reward.put("reputations", new TreeMap<>(quest.getReward().getReputations()));
+      reward.put("titles", quest.getReward().getTitles());
+      reward.put("commands", quest.getReward().getCommands());
+      reward.put("custom", canonical(quest.getReward().getCustomRewards()));
+      reward.put(
+          "items",
+          quest.getReward().getItems().stream()
+              .map(item -> Base64.getEncoder().encodeToString(item.serializeAsBytes()))
+              .toList());
+      definition.put("reward", reward);
+    } else definition.put("reward", null);
+    try {
+      return HexFormat.of()
+          .formatHex(
+              MessageDigest.getInstance("SHA-256")
+                  .digest(GSON.toJson(definition).getBytes(StandardCharsets.UTF_8)));
+    } catch (NoSuchAlgorithmException impossible) {
+      throw new IllegalStateException(impossible);
+    }
+  }
+
+  private static Object canonical(Object value) {
+    if (value == null
+        || value instanceof String
+        || value instanceof Number
+        || value instanceof Boolean
+        || value instanceof Enum<?>) return value;
+    if (value instanceof Map<?, ?> map) {
+      Map<String, Object> sorted = new TreeMap<>();
+      map.forEach((key, entry) -> sorted.put(String.valueOf(key), canonical(entry)));
+      return sorted;
+    }
+    if (value instanceof List<?> list)
+      return list.stream().map(QuestDefinitionFingerprint::canonical).toList();
+    throw new IllegalArgumentException(
+        "Unsupported quest definition metadata: " + value.getClass().getName());
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/quest/evidence/QuestEvidenceAuthority.java b/src/main/java/dev/starcore/starcore/quest/evidence/QuestEvidenceAuthority.java
