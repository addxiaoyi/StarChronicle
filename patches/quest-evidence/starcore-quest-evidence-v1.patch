+++ b/src/test/java/dev/starcore/starcore/quest/evidence/QuestCompletionJournalTest.java
@@ -0,0 +1,73 @@
+package dev.starcore.starcore.quest.evidence;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class QuestCompletionJournalTest {
+  @TempDir Path directory;
+
+  private QuestEvidenceService.Snapshot receipt(String status, String message) {
+    return new QuestEvidenceService.Snapshot(
+        "binding",
+        "run",
+        UUID.fromString("00000000-0000-0000-0000-000000000001"),
+        "quest",
+        "a".repeat(64),
+        100,
+        "KNOWN_NATION",
+        "nation",
+        99,
+        "00000000-0000-0000-0000-000000000002",
+        200,
+        "KNOWN_NATION",
+        "nation",
+        199,
+        status,
+        "PREPARED",
+        QuestEvidenceService.ISSUER,
+        "immutable-acceptance",
+        "immutable-completion",
+        201,
+        "journal-proof",
+        message);
+  }
+
+  @Test
+  void immutableCommitRoundTripsWithoutRewardDeliveryClaim() throws Exception {
+    QuestCompletionJournal journal = new QuestCompletionJournal(directory);
+    QuestEvidenceService.Snapshot receipt = receipt("COMPLETED", "committed");
+    journal.append(receipt);
+    assertEquals(java.util.List.of(receipt), journal.load());
+    assertEquals("PREPARED", journal.load().getFirst().rewardStatus());
+  }
+
+  @Test
+  void identicalAppendIsIdempotentButConflictingPayloadFails() throws Exception {
+    QuestCompletionJournal journal = new QuestCompletionJournal(directory);
+    journal.append(receipt("COMPLETED", "original"));
+    journal.append(receipt("COMPLETED", "original"));
+    assertThrows(
+        java.io.IOException.class, () -> journal.append(receipt("COMPLETED", "different")));
+    assertEquals("original", journal.load().getFirst().message());
+  }
+
+  @Test
+  void preparedGuardAndAcceptanceCanNeverBeAppendedAsCompletion() {
+    QuestCompletionJournal journal = new QuestCompletionJournal(directory);
+    assertThrows(
+        IllegalArgumentException.class, () -> journal.append(receipt("COMPLETING", "guard")));
+    assertThrows(
+        IllegalArgumentException.class, () -> journal.append(receipt("ACTIVE", "accepted")));
+  }
+
+  @Test
+  void corruptJournalFailsClosed() throws Exception {
+    Files.writeString(directory.resolve("corrupt.json"), "{not-json");
+    assertThrows(java.io.IOException.class, () -> new QuestCompletionJournal(directory).load());
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/quest/evidence/QuestEvidenceAuthorityTest.java b/src/test/java/dev/starcore/starcore/quest/evidence/QuestEvidenceAuthorityTest.java
new file mode 100644
index 0000000..4d04ded
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/quest/evidence/QuestEvidenceAuthorityTest.java
@@ -0,0 +1,125 @@
+package dev.starcore.starcore.quest.evidence;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Properties;
+import java.util.UUID;
+import java.util.concurrent.Executors;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class QuestEvidenceAuthorityTest {
+  @TempDir Path directory;
+
+  private void properties(String name, String key, String value) throws Exception {
+    Properties state = new Properties();
+    state.setProperty(key, value);
+    try (OutputStream output = Files.newOutputStream(directory.resolve(name))) {
+      state.store(output, "test");
+    }
+  }
+
+  @Test
+  void freshAuthorityIsCanonicalAndSurvivesRepeatedInitialization() throws Exception {
+    String authority = QuestEvidenceAuthority.loadOrCreate(directory);
+    assertEquals(authority, UUID.fromString(authority).toString());
+    assertEquals(authority, QuestEvidenceAuthority.loadOrCreate(directory));
+    assertTrue(
+        Files.readString(directory.resolve(QuestEvidenceAuthority.FILE_NAME)).contains(authority));
+  }
+
+  @Test
+  void concurrentInitializationInSameJvmCannotRotateTheDomain() throws Exception {
+    try (var executor = Executors.newFixedThreadPool(4)) {
+      List<java.util.concurrent.Future<String>> results = new ArrayList<>();
+      for (int i = 0; i < 8; i++)
+        results.add(executor.submit(() -> QuestEvidenceAuthority.loadOrCreate(directory)));
+      String first = results.getFirst().get();
+      for (var result : results) assertEquals(first, result.get());
+      assertEquals(first, QuestEvidenceAuthority.loadOrCreate(directory));
+    }
+  }
+
+  @Test
+  void corruptPrimaryIsPreservedEvenWhenValidLookingBackupExists() throws Exception {
+    String original = QuestEvidenceAuthority.loadOrCreate(directory);
+    Files.copy(
+        directory.resolve(QuestEvidenceAuthority.FILE_NAME),
+        directory.resolve(QuestEvidenceAuthority.FILE_NAME + ".bak"));
+    Files.writeString(directory.resolve(QuestEvidenceAuthority.FILE_NAME), "broken-authority");
+    assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(directory));
+    assertEquals(
+        "broken-authority", Files.readString(directory.resolve(QuestEvidenceAuthority.FILE_NAME)));
+    assertTrue(
+        Files.readString(directory.resolve(QuestEvidenceAuthority.FILE_NAME + ".bak"))
+            .contains(original));
+  }
+
+  @Test
+  void missingPrimaryWithAnyRecoveryArtifactFailsClosedAndPreservesEveryArtifact()
+      throws Exception {
+    for (String suffix : List.of(".tmp", ".bak", ".bak.tmp", ".delete")) {
+      Path isolated = directory.resolve(suffix.substring(1).replace('.', '-'));
+      Files.createDirectories(isolated);
+      Path artifact = isolated.resolve(QuestEvidenceAuthority.FILE_NAME + suffix);
+      Files.writeString(artifact, "original-artifact");
+      assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(isolated));
+      assertEquals("original-artifact", Files.readString(artifact));
+      assertFalse(Files.exists(isolated.resolve(QuestEvidenceAuthority.FILE_NAME)));
+    }
+  }
+
+  @Test
+  void existingTrackedIndexOrItsRecoveryArtifactsForbidMintingAnotherAuthority() throws Exception {
+    for (String suffix : List.of("", ".tmp", ".bak", ".delete")) {
+      Path isolated = directory.resolve("case-" + suffix.replace('.', '-'));
+      Files.createDirectories(isolated);
+      Files.writeString(
+          isolated.resolve("tracked-evidence.properties" + suffix), "existing-domain");
+      assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(isolated));
+      assertFalse(Files.exists(isolated.resolve(QuestEvidenceAuthority.FILE_NAME)));
+    }
+  }
+
+  @Test
+  void journalDirectoryWithoutAuthorityIsNeverTreatedAsFreshStorage() throws Exception {
+    Files.createDirectories(directory.resolve("completion-journal"));
+    Files.writeString(directory.resolve("completion-journal/completion.json"), "existing-record");
+    assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(directory));
+    assertEquals(
+        "existing-record",
+        Files.readString(directory.resolve("completion-journal/completion.json")));
+  }
+
+  @Test
+  void independentNativeTrackedBindingSurvivesLostIndexAndPreventsNewAuthority() throws Exception {
+    properties("quests.properties", "player.active", "[{\"id\":\"q\",\"bindingId\":\"binding\"}]");
+    assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(directory));
+    assertFalse(Files.exists(directory.resolve(QuestEvidenceAuthority.FILE_NAME)));
+  }
+
+  @Test
+  void nativeRunReceiptMarkerIncludingLegacyNullAlsoForbidsIdentityRotation() throws Exception {
+    properties("quests.properties.bak", "player.runCompletions", "null");
+    assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(directory));
+    assertFalse(Files.exists(directory.resolve(QuestEvidenceAuthority.FILE_NAME)));
+  }
+
+  @Test
+  void legacyUnboundNativeQuestsPermitFirstEvidenceUpgrade() throws Exception {
+    properties("quests.properties", "player.active", "[{\"id\":\"legacy\",\"bindingId\":null}]");
+    assertNotNull(QuestEvidenceAuthority.loadOrCreate(directory));
+  }
+
+  @Test
+  void malformedNativeActiveStateCannotBeAssumedUntracked() throws Exception {
+    properties("quests.properties", "player.active", "{broken-json");
+    assertThrows(java.io.IOException.class, () -> QuestEvidenceAuthority.loadOrCreate(directory));
+    assertFalse(Files.exists(directory.resolve(QuestEvidenceAuthority.FILE_NAME)));
+  }
+}
