+class QuestEvidenceServiceTest {
+  @TempDir Path directory;
+
+  private static Quest definition(int required) {
+    return definition(required, QuestType.SIDE, 0);
+  }
+
+  private static Quest definition(int required, QuestType type, long timeLimit) {
+    return new Quest.Builder(
+            "native-probe", "Probe", "Native objective", type, QuestDifficulty.NORMAL)
+        .addObjective(
+            new QuestObjective("kill", QuestObjective.ObjectiveType.KILL_ENTITY, "Kill", required))
+        .timeLimit(timeLimit)
+        .build();
+  }
+
+  private final class Fixture implements AutoCloseable {
+    final UUID playerId = UUID.randomUUID();
+    final Player player = mock(Player.class);
+    final PersistenceService persistence = mock(PersistenceService.class);
+    final Map<String, Properties> files = new HashMap<>();
+    final AtomicReference<CompletableFuture<Void>> pauseEvidence = new AtomicReference<>();
+    final AtomicReference<NationService> nationProvider = new AtomicReference<>();
+    final MockedStatic<Bukkit> bukkit = mockStatic(Bukkit.class);
+    final QuestService quests;
+    final QuestEvidenceService service;
+
+    Fixture() {
+      this(QuestType.SIDE, 0);
+    }
+
+    Fixture(QuestType type, long timeLimit) {
+      JavaPlugin plugin = mock(JavaPlugin.class);
+      when(plugin.isEnabled()).thenReturn(true);
+      when(plugin.getLogger()).thenReturn(Logger.getAnonymousLogger());
+      when(player.getUniqueId()).thenReturn(playerId);
+      when(player.isOnline()).thenReturn(true);
+      bukkit.when(Bukkit::isPrimaryThread).thenReturn(true);
+      bukkit.when(() -> Bukkit.getPlayer(playerId)).thenReturn(player);
+      when(persistence.dataDirectory()).thenReturn(directory);
+      when(persistence.loadProperties(anyString(), anyString()))
+          .thenAnswer(
+              call -> {
+                Properties value = new Properties();
+                value.putAll(files.getOrDefault(call.getArgument(1), new Properties()));
+                return value;
+              });
+      when(persistence.savePropertiesAsync(anyString(), anyString(), any()))
+          .thenAnswer(
+              call -> {
+                String file = call.getArgument(1);
+                Properties snapshot = new Properties();
+                snapshot.putAll((Properties) call.getArgument(2));
+                CompletableFuture<Void> paused =
+                    "tracked-evidence.properties".equals(file)
+                        ? pauseEvidence.getAndSet(null)
+                        : null;
+                if (paused != null) return paused.thenRun(() -> files.put(file, snapshot));
+                files.put(file, snapshot);
+                return CompletableFuture.completedFuture(null);
+              });
+      quests = spy(new QuestService(null, null, null, persistence, Logger.getAnonymousLogger()));
+      quests.registerQuest(definition(1, type, timeLimit));
+      quests.initialize();
+      service = new QuestEvidenceService(plugin, quests, persistence, nationProvider::get);
+      quests.setEvidenceService(service);
+      service.initialize();
+      assertTrue(service.available());
+    }
+
+    CompletableFuture<Void> pauseNextReservation() {
+      CompletableFuture<Void> future = new CompletableFuture<>();
+      pauseEvidence.set(future);
+      return future;
+    }
+
+    QuestEvidenceService.Admission begin(String binding) {
+      return service
+          .beginTracked(playerId, "native-probe", binding, null, false)
+          .toCompletableFuture()
