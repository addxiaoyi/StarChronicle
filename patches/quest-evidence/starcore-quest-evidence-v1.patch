diff --git a/src/test/java/dev/starcore/starcore/quest/QuestTrackedRunPersistenceTest.java b/src/test/java/dev/starcore/starcore/quest/QuestTrackedRunPersistenceTest.java
new file mode 100644
index 0000000..d9b1adf
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/quest/QuestTrackedRunPersistenceTest.java
@@ -0,0 +1,238 @@
+package dev.starcore.starcore.quest;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import dev.starcore.starcore.quest.evidence.QuestDefinitionFingerprint;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Properties;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.logging.Logger;
+import org.bukkit.entity.EntityType;
+import org.junit.jupiter.api.Test;
+
+class QuestTrackedRunPersistenceTest {
+  private static Quest definition(int required) {
+    QuestObjective objective =
+        new QuestObjective(
+            "zombies", QuestObjective.ObjectiveType.KILL_ENTITY, "Defeat zombies", required);
+    objective.setTargetEntity(EntityType.ZOMBIE);
+    return new Quest.Builder(
+            "native-zombies",
+            "Native zombies",
+            "Real objective",
+            QuestType.SIDE,
+            QuestDifficulty.NORMAL)
+        .addObjective(objective)
+        .repeatable(true)
+        .build();
+  }
+
+  private static final class MemoryStorage implements QuestStateStorage {
+    Properties state = new Properties();
+    CompletableFuture<Void> confirmation = CompletableFuture.completedFuture(null);
+
+    @Override
+    public Properties load() {
+      Properties copy = new Properties();
+      copy.putAll(state);
+      return copy;
+    }
+
+    @Override
+    public void save(Properties value) {
+      state = new Properties();
+      state.putAll(value);
+    }
+
+    @Override
+    public void saveAsync(Properties value) {
+      save(value);
+    }
+
+    @Override
+    public java.util.concurrent.CompletionStage<Void> saveConfirmed(Properties value) {
+      save(value);
+      return confirmation;
+    }
+  }
+
+  @Test
+  void exactRunStartAndObjectiveProgressSurviveDeferredTemplateRegistration() {
+    Quest quest = definition(3);
+    UUID playerId = UUID.randomUUID();
+    PlayerQuest player = new PlayerQuest(playerId);
+    String fingerprint = QuestDefinitionFingerprint.of(quest);
+    assertTrue(player.acceptQuest(quest, "run-original", "binding-original", fingerprint));
+    long started = player.getQuestStartTimes().get(quest.getId());
+    player.updateQuestProgress(quest.getId(), 0, 2);
+    MemoryStorage storage = new MemoryStorage();
+    new QuestPersistenceHandler(storage, Logger.getAnonymousLogger())
+        .savePlayerQuests(Map.of(playerId, player));
+    QuestPersistenceHandler restoredHandler =
+        new QuestPersistenceHandler(storage, Logger.getAnonymousLogger());
+    Map<UUID, PlayerQuest> restored = new HashMap<>();
+    restoredHandler.loadPlayerQuests(restored, Map.of());
+    assertFalse(restored.get(playerId).hasActiveQuest(quest.getId()));
+    restoredHandler.savePlayerQuests(restored);
+    assertTrue(storage.state.getProperty("pq." + playerId + ".active").contains("run-original"));
+    restoredHandler.restorePendingQuest(quest.getId(), restored, Map.of(quest.getId(), quest));
+    PlayerQuest after = restored.get(playerId);
+    assertEquals("run-original", after.getQuestRunId(quest.getId()));
+    assertEquals("binding-original", after.getQuestBindingId(quest.getId()));
+    assertEquals(fingerprint, after.getQuestDefinitionFingerprint(quest.getId()));
+    assertEquals(started, after.getQuestStartTimes().get(quest.getId()));
+    assertEquals(
+        2, after.getActiveQuest(quest.getId()).getObjectives().getFirst().getCurrentProgress());
+    assertTrue(after.getRunCompletions().isEmpty());
+  }
+
+  @Test
+  void changedDefinitionIsQuarantinedAndOriginalSavedRunIsRetained() {
+    Quest quest = definition(3);
+    UUID id = UUID.randomUUID();
+    PlayerQuest player = new PlayerQuest(id);
+    player.acceptQuest(quest, "old-run", "binding", QuestDefinitionFingerprint.of(quest));
+    player.updateQuestProgress(quest.getId(), 0, 2);
+    MemoryStorage storage = new MemoryStorage();
+    new QuestPersistenceHandler(storage, Logger.getAnonymousLogger())
+        .savePlayerQuests(Map.of(id, player));
+    Map<UUID, PlayerQuest> restored = new HashMap<>();
+    QuestPersistenceHandler handler =
+        new QuestPersistenceHandler(storage, Logger.getAnonymousLogger());
+    handler.loadPlayerQuests(restored, Map.of(quest.getId(), definition(1)));
+    assertFalse(restored.get(id).hasActiveQuest(quest.getId()));
+    handler.savePlayerQuests(restored);
+    assertTrue(storage.state.getProperty("pq." + id + ".active").contains("old-run"));
+    handler.restorePendingQuest(quest.getId(), restored, Map.of(quest.getId(), quest));
+    assertEquals(
+        2,
+        restored
+            .get(id)
+            .getActiveQuest(quest.getId())
+            .getObjectives()
+            .getFirst()
+            .getCurrentProgress());
+  }
+
+  @Test
+  void readyToCompleteIsNotACompletionReceipt() {
+    Quest quest = definition(1);
+    PlayerQuest player = new PlayerQuest(UUID.randomUUID());
+    player.acceptQuest(quest, "run", "binding", QuestDefinitionFingerprint.of(quest));
+    player.updateQuestProgress(quest.getId(), 0, 1);
+    assertTrue(player.getActiveQuest(quest.getId()).isAllObjectivesCompleted());
+    assertTrue(player.getRunCompletions().isEmpty());
+    assertFalse(player.hasCompletedQuest(quest.getId()));
+  }
+
+  @Test
+  void nativeCompletionReceiptPersistsSeparatelyFromTemplateAndRewards() {
+    Quest quest = definition(1);
+    UUID id = UUID.randomUUID();
+    PlayerQuest player = new PlayerQuest(id);
+    String fingerprint = QuestDefinitionFingerprint.of(quest);
+    player.acceptQuest(quest, "run", "binding", fingerprint);
+    long started = player.getQuestStartTimes().get(quest.getId());
+    assertFalse(player.completeQuest(quest.getId(), started + 10, "completion"));
+    player.updateQuestProgress(quest.getId(), 0, 1);
+    assertTrue(player.completeQuest(quest.getId(), started + 20, "completion"));
+    MemoryStorage storage = new MemoryStorage();
+    new QuestPersistenceHandler(storage, Logger.getAnonymousLogger())
+        .savePlayerQuests(Map.of(id, player));
+    assertTrue(storage.state.getProperty("pq." + id + ".runCompletions").startsWith("["));
+    Map<UUID, PlayerQuest> restored = new HashMap<>();
+    new QuestPersistenceHandler(storage, Logger.getAnonymousLogger())
+        .loadPlayerQuests(restored, Map.of());
+    assertEquals(
+        new PlayerQuest.RunCompletion(
+            "run", quest.getId(), "binding", fingerprint, started, started + 20, "completion"),
+        restored.get(id).getRunCompletions().get("run"));
+    assertFalse(restored.get(id).hasActiveQuest(quest.getId()));
+  }
+
+  @Test
+  void eachRepeatedAcceptanceGetsIndependentRunId() {
+    PlayerQuest player = new PlayerQuest(UUID.randomUUID());
+    Quest quest = definition(1);
+    player.acceptQuest(quest);
+    String original = player.getQuestRunId(quest.getId());
+    player.abandonQuest(quest.getId());
+    player.acceptQuest(quest);
+    assertNotEquals(original, player.getQuestRunId(quest.getId()));
+  }
+
+  @Test
+  void fingerprintIgnoresProgressButIncludesActualObjectiveDefinition() {
+    Quest quest = definition(3);
+    String original = QuestDefinitionFingerprint.of(quest);
+    quest.getObjectives().getFirst().setProgress(2);
+    assertEquals(original, QuestDefinitionFingerprint.of(quest));
+    assertNotEquals(original, QuestDefinitionFingerprint.of(definition(4)));
+    quest.getObjectives().getFirst().setTargetEntity(EntityType.SKELETON);
+    assertNotEquals(original, QuestDefinitionFingerprint.of(quest));
+    assertTrue(original.matches("[0-9a-f]{64}"));
+  }
+
+  @Test
+  void confirmedFutureDoesNotAcknowledgeBeforeStorageCommit() {
+    MemoryStorage storage = new MemoryStorage();
+    storage.confirmation = new CompletableFuture<>();
+    var future =
+        new QuestPersistenceHandler(storage, Logger.getAnonymousLogger())
+            .savePlayerQuestsConfirmed(Map.of())
+            .toCompletableFuture();
+    assertFalse(future.isDone());
+    storage.confirmation.complete(null);
+    assertTrue(future.isDone());
+    assertFalse(future.isCompletedExceptionally());
+  }
+
+  @Test
+  void actualPersistenceFutureAndFailurePropagateUnchanged() {
+    PersistenceService persistence = mock(PersistenceService.class);
+    CompletableFuture<Void> write = new CompletableFuture<>();
+    when(persistence.savePropertiesAsync(eq("quest"), eq("quests.properties"), any()))
+        .thenReturn(write);
+    QuestStateStorage storage = new PersistenceQuestStateStorage("quest", persistence);
+    Properties props = new Properties();
+    props.setProperty("pq.player.active", "[]");
+    var future = storage.saveConfirmed(props).toCompletableFuture();
+    assertSame(write, future);
+    assertFalse(future.isDone());
+    write.completeExceptionally(new IllegalStateException("disk failed"));
+    assertThrows(java.util.concurrent.CompletionException.class, future::join);
+    verify(persistence, never())
+        .savePropertiesAsync(eq("quest"), eq("daily_quests.properties"), any());
+    verify(persistence, never())
+        .savePropertiesAsync(eq("quest"), eq("commissions.properties"), any());
+  }
+
+  @Test
+  void otherQuestSubsystemSavesCannotEraseNativeRunLedger() {
+    PersistenceService persistence = mock(PersistenceService.class);
+    QuestStateStorage storage = new PersistenceQuestStateStorage("quest", persistence);
+    Properties props = new Properties();
+    props.setProperty("dq.refresh_times", "example");
+    storage.save(props);
+    storage.saveAsync(props);
+    verify(persistence, never()).saveProperties(eq("quest"), eq("quests.properties"), any());
+    verify(persistence, never()).savePropertiesAsync(eq("quest"), eq("quests.properties"), any());
+  }
+
+  @Test
+  void legacyNullReceiptCollectionIsEmptyAndNeverManufacturesCompletionProof() {
+    UUID id = UUID.randomUUID();
+    MemoryStorage storage = new MemoryStorage();
+    storage.state.setProperty("pq." + id + ".runCompletions", "null");
+    Map<UUID, PlayerQuest> restored = new HashMap<>();
+    new QuestPersistenceHandler(storage, Logger.getAnonymousLogger())
+        .loadPlayerQuests(restored, Map.of());
+    assertTrue(restored.get(id).getRunCompletions().isEmpty());
+    assertTrue(restored.get(id).getCompletedQuests().isEmpty());
+  }
+}
