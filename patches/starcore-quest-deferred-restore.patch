+    private SectionData sectionData(Section section, Properties properties) {
+        Objects.requireNonNull(section, "section");
+        Objects.requireNonNull(properties, "properties");
+        String prefix = switch (section) { case PLAYER -> "pq."; case DAILY -> "dq."; case COMMISSION -> "cm."; case LEADERBOARD -> "cl."; };
+        String file = switch (section) { case PLAYER -> PLAYER_QUEST_FILE; case DAILY -> DAILY_QUEST_FILE; case COMMISSION -> COMMISSION_FILE; case LEADERBOARD -> LEADERBOARD_FILE; };
+        Properties values = new Properties();
+        for (String key : properties.stringPropertyNames()) {
+            if (!key.startsWith(prefix)) throw new IllegalArgumentException("Foreign quest section in " + section + ": " + key);
+            values.setProperty(key.substring(prefix.length()), properties.getProperty(key));
+        }
+        return new SectionData(file, values);
     }
+
+    private record SectionData(String file, Properties properties) {}
 }
