+package dev.starcore.starcore.quest;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import dev.starcore.starcore.core.persistence.PersistenceService;
+import java.util.*;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+/** Genuine Quest/PlayerQuest objects expose the old double-clone progress reset; the storage
+ * fixture simulates repeated restarts and both persistence paths without a Minecraft server. */
+class DeferredQuestRestoreTest {
+    static final long STARTED=1_700_000_000_123L;
+    static final String LATE="chronicle_late",OTHER="another_plugin_late";
+    final UUID player=UUID.randomUUID();
+    final MemoryStorage storage=new MemoryStorage();
+    final Logger log=Logger.getAnonymousLogger();
+    QuestPersistenceHandler handler(){return new QuestPersistenceHandler(storage,log);}
+    Quest template(String id){return new Quest.Builder(id,id,"Test",QuestType.SIDE,QuestDifficulty.EASY)
+        .addObjective(new QuestObjective("objective",QuestObjective.ObjectiveType.CUSTOM,"Evidence",10)).build();}
+    JsonObject saved(String id,int progress) {
+        JsonObject quest=new JsonObject();quest.addProperty("id",id);quest.addProperty("name","Saved "+id);quest.addProperty("type","SIDE");quest.addProperty("difficulty","EASY");
+        JsonArray objectives=new JsonArray();JsonObject objective=new JsonObject();objective.addProperty("id","objective");objective.addProperty("type","CUSTOM");objective.addProperty("progress",progress);objectives.add(objective);quest.add("objectives",objectives);
+        JsonObject opaque=new JsonObject();opaque.addProperty("external","preserved");quest.add("future_metadata",opaque);return quest;
+    }
+    void seed(UUID id,JsonObject... quests) {
+        JsonArray active=new JsonArray();StringJoiner starts=new StringJoiner(";");for(JsonObject quest:quests){active.add(quest);starts.add(quest.get("id").getAsString()+":"+STARTED);}
+        storage.stored.setProperty("pq."+id+".active",active.toString());storage.stored.setProperty("pq."+id+".startTimes",starts.toString());
+    }
+    JsonArray storedActive(UUID id){return JsonParser.parseString(storage.stored.getProperty("pq."+id+".active","[]")).getAsJsonArray();}
+    int progress(PlayerQuest pq,String id){return pq.getActiveQuest(id).getObjectives().getFirst().getCurrentProgress();}
+
+    @Test void unknownTemplateSurvivesSyncSaveAndTwoRestartsBeforeRegistration() {
+        JsonObject original=saved(LATE,4);seed(player,original);Map<UUID,PlayerQuest> first=new HashMap<>();QuestPersistenceHandler a=handler();a.loadPlayerQuests(first,Map.of());
+        assertFalse(first.get(player).hasActiveQuest(LATE));a.savePlayerQuests(first);assertEquals(original,storedActive(player).get(0));
+        Map<UUID,PlayerQuest> second=new HashMap<>();QuestPersistenceHandler b=handler();b.loadPlayerQuests(second,Map.of());b.savePlayerQuestsAsync(second);
+        Map<UUID,PlayerQuest> third=new HashMap<>();QuestPersistenceHandler c=handler();c.loadPlayerQuests(third,Map.of());
+        assertEquals(1,c.restoreDeferredQuest(LATE,third,Map.of(LATE,template(LATE))));assertEquals(4,progress(third.get(player),LATE));assertEquals(STARTED,third.get(player).getQuestStartTimes().get(LATE));
+    }
+    @Test void asyncSavePreservesOpaqueUnknownJsonAndOriginalStartTime() {
+        JsonObject original=saved(LATE,7);seed(player,original);Map<UUID,PlayerQuest> players=new HashMap<>();QuestPersistenceHandler h=handler();h.loadPlayerQuests(players,Map.of());h.savePlayerQuestsAsync(players);
+        assertEquals(1,storage.asyncSaves);assertEquals(original,storedActive(player).get(0));assertTrue(storage.stored.getProperty("pq."+player+".startTimes").contains(LATE+":"+STARTED));
+    }
+    @Test void knownTemplateAlsoKeepsRealObjectiveProgressWithoutDoubleCloning() {
+        seed(player,saved(LATE,6));Map<UUID,PlayerQuest> players=new HashMap<>();handler().loadPlayerQuests(players,Map.of(LATE,template(LATE)));
+        assertEquals(6,progress(players.get(player),LATE));assertEquals(STARTED,players.get(player).getQuestStartTimes().get(LATE));
+    }
+    @Test void oneRegisteredTemplateDoesNotRestoreOrDiscardOtherPendingDefinitions() {
+        seed(player,saved(LATE,2),saved(OTHER,8));Map<UUID,PlayerQuest> players=new HashMap<>();QuestPersistenceHandler h=handler();h.loadPlayerQuests(players,Map.of());
+        assertEquals(1,h.restoreDeferredQuest(LATE,players,Map.of(LATE,template(LATE))));assertFalse(players.get(player).hasActiveQuest(OTHER));h.savePlayerQuests(players);
+        assertEquals(2,storedActive(player).size());assertTrue(storedActive(player).toString().contains("future_metadata"));
+        assertEquals(1,h.restoreDeferredQuest(OTHER,players,Map.of(OTHER,template(OTHER))));assertEquals(8,progress(players.get(player),OTHER));
+    }
+    @Test void deferredRestoreIsIdempotentAndNeverCompletesOrRewardsTheQuest() {
+        seed(player,saved(LATE,3));Map<UUID,PlayerQuest> players=new HashMap<>();QuestPersistenceHandler h=handler();h.loadPlayerQuests(players,Map.of());Map<String,Quest> registry=Map.of(LATE,template(LATE));
+        assertEquals(1,h.restoreDeferredQuest(LATE,players,registry));assertEquals(0,h.restoreDeferredQuest(LATE,players,registry));assertEquals(1,players.get(player).getActiveQuestCount());assertFalse(players.get(player).hasCompletedQuest(LATE));
+    }
+    @Test void existingLiveInstanceWinsAndStalePendingCopyCannotResurrectAfterAbandon() {
+        seed(player,saved(LATE,2));Map<UUID,PlayerQuest> players=new HashMap<>();QuestPersistenceHandler h=handler();h.loadPlayerQuests(players,Map.of());
+        players.get(player).acceptQuest(template(LATE));players.get(player).updateQuestProgress(LATE,0,9);Quest live=players.get(player).getActiveQuest(LATE);
+        assertEquals(0,h.restoreDeferredQuest(LATE,players,Map.of(LATE,template(LATE))));assertSame(live,players.get(player).getActiveQuest(LATE));assertEquals(9,progress(players.get(player),LATE));
+        players.get(player).abandonQuest(LATE);h.savePlayerQuests(players);assertEquals(0,storedActive(player).size());
