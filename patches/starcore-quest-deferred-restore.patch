+    /** Restore only the newly registered template, preserving saved progress and start time.
+     * No Bukkit calls, acceptance commands, completion or rewards occur on this path. */
+    synchronized int restoreDeferredQuest(String questId, Map<UUID, PlayerQuest> playerQuests,
+                                          Map<String, Quest> questRegistry) {
+        if (!questRegistry.containsKey(questId)) return 0;
+        int restored = 0;
+        Iterator<Map.Entry<UUID, Map<String, DeferredActiveQuest>>> players = deferredActiveQuests.entrySet().iterator();
+        while (players.hasNext()) {
+            Map.Entry<UUID, Map<String, DeferredActiveQuest>> player = players.next();
+            DeferredActiveQuest saved = player.getValue().get(questId);
+            if (saved == null) continue;
+            PlayerQuest target = playerQuests.computeIfAbsent(player.getKey(), PlayerQuest::new);
+            if (target.hasActiveQuest(questId)) {
+                // Never overwrite a current live instance with an old pending snapshot.
+                player.getValue().remove(questId);
+            } else {
+                try {
+                    Quest quest = deserializeQuest(saved.json(), questRegistry);
+                    if (quest != null && target.restoreActiveQuest(quest, saved.startedAt())) {
+                        if (target.isQuestExpired(questId)) target.failQuest(questId);
+                        player.getValue().remove(questId);
+                        restored++;
+                    }
+                } catch (RuntimeException failure) {
+                    logger.warning("[QuestPersistence] Deferred quest " + questId + " for "
+                        + player.getKey() + " retained after restore failure: " + failure.getMessage());
+                }
+            }
+            if (player.getValue().isEmpty()) players.remove();
+        }
+        return restored;
+    }
+
+    private void mergeDeferredQuests(Properties properties, Map<UUID, PlayerQuest> playerQuests) {
+        Iterator<Map.Entry<UUID, Map<String, DeferredActiveQuest>>> players = deferredActiveQuests.entrySet().iterator();
+        while (players.hasNext()) {
+            Map.Entry<UUID, Map<String, DeferredActiveQuest>> player = players.next();
+            PlayerQuest current = playerQuests.get(player.getKey());
+            // A new live instance always wins. Remove the stale pending copy as well so it
+            // cannot reappear after that instance is later completed or abandoned.
+            if (current != null) player.getValue().keySet().removeIf(current::hasActiveQuest);
+            if (player.getValue().isEmpty()) { players.remove(); continue; }
+            String prefix = "pq." + player.getKey() + ".";
+            JsonArray active = properties.containsKey(prefix + "active")
+                ? JsonParser.parseString(properties.getProperty(prefix + "active")).getAsJsonArray() : new JsonArray();
+            Map<String, Long> startTimes = parseStartTimes(properties.getProperty(prefix + "startTimes"));
+            for (Map.Entry<String, DeferredActiveQuest> entry : player.getValue().entrySet()) {
+                active.add(entry.getValue().json().deepCopy());
+                startTimes.put(entry.getKey(), entry.getValue().startedAt());
+            }
+            properties.setProperty(prefix + "active", GSON.toJson(active));
+            StringJoiner starts = new StringJoiner(";");
+            new TreeMap<>(startTimes).forEach((id, time) -> starts.add(id + ":" + time));
+            properties.setProperty(prefix + "startTimes", starts.toString());
+        }
+    }
+
+    private static Map<String, Long> parseStartTimes(String serialized) {
+        Map<String, Long> values = new HashMap<>();
+        if (serialized == null || serialized.isEmpty()) return values;
+        for (String entry : serialized.split(";")) {
+            int separator = entry.lastIndexOf(':');
+            if (separator <= 0) continue;
+            try { values.put(entry.substring(0, separator), Long.parseLong(entry.substring(separator + 1))); }
+            catch (NumberFormatException ignored) { /* Isolate malformed optional metadata. */ }
+        }
+        return values;
+    }
